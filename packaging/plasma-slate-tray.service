[Unit]
Description=Plasma Slate tray icon and window
Documentation=https://github.com/hassanm0301/plasma-slate
# Pulled in by slated.service; not bound to it, so it keeps showing "not running" when the daemon stops.
PartOf=graphical-session.target
After=graphical-session.target plasma-plasmashell.service
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/plasma-slate-tray --background
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
