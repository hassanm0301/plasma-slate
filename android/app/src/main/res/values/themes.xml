<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PlasmaSlate" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:colorAccent">#3DAEE9</item>
        <item name="android:colorPrimary">#1D99F3</item>
    </style>

    <style name="Theme.PlasmaSlate.Fullscreen" parent="android:Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
